# ==============================================================================
# DICOM De-Identifier Environment Configuration
# ==============================================================================

# Directory paths (the image sets these; locally they default under app/)
SKALD_DATA_DIR=/app/data
SKALD_CONFIG_DIR=/app/config
SKALD_OUTPUT_DIR=/app/output

# Where secured.json (hash keys + reverse token vault) is kept. Must NOT be
# inside SKALD_OUTPUT_DIR or anything else that is shipped. Defaults to the
# working directory when unset.
SKALD_KEYS_DIR=/app/keys
