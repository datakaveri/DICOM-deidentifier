# ==============================================================================
# DICOM De-Identifier Environment Configuration
# ==============================================================================

# Directory paths (defaults resolve inside the container/local environment)
SKALD_DATA_DIR=/app/data
SKALD_CONFIG_DIR=/app/config
SKALD_OUTPUT_DIR=/app/output

# Flag to enable/disable tag de-identification (True/False)
ENABLE_TAG_DEIDENTIFICATION=True
